# ─────────────────────────────────────────────────────────────────────────────
# Véronique AI — Environment variables
# Copy this file to `.env` (local dev) or set these in the Vercel project
# dashboard (Production + Preview environments).
# ─────────────────────────────────────────────────────────────────────────────

# ── DATABASE ─────────────────────────────────────────────────────────────────
# Local dev: SQLite file (no setup needed).
DATABASE_URL="file:./db/custom.db"

# Production (Vercel): Turso libSQL database.
#   1. Create a free DB at https://turso.tech → app
#   2. Create a database, grab its URL + auth token.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ── LLM (Large Language Model) ───────────────────────────────────────────────
# Pick one or more — the app tries each in order until one works:
#   LLM chain: Groq → OpenRouter → z-ai SDK
# At least the z-ai SDK always works as a final fallback (pre-configured here).

# Groq — Llama 3.3 70B (fast, free). https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter — Llama 3.3 70B free tier (reachable from any host). https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ── STT (Speech-to-Text) ────────────────────────────────────────────────────
# Groq Whisper Large v3 Turbo (if GROQ_API_KEY is set), else z-ai SDK.
# `language=fr` is always forced + an anti-hallucination French filter runs.
# (No separate env var — reuses GROQ_API_KEY.)

# ── TTS (Text-to-Speech) ─────────────────────────────────────────────────────
# ElevenLabs — natural multilingual French voice. https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
